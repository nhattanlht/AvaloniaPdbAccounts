<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:AvaloniaPdbAccounts.ViewModels.TRGDV"
             x:Class="AvaloniaPdbAccounts.Views.TRGDV.CoursesTRGDVView"
             x:DataType="vm:CoursesTRGDVViewModel">

    <Grid Margin="20" RowDefinitions="Auto,*">
        <TextBlock Text="Danh sách môn học" FontSize="24" FontWeight="Bold" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Courses}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã môn" Binding="{Binding CourseID}" IsReadOnly="True" />
                <DataGridTextColumn Header="Mã học phần" Binding="{Binding BaseCode}" IsReadOnly="True" />
                <DataGridTextColumn Header="Mã GV" Binding="{Binding TeacherID}" IsReadOnly="True" />
                <DataGridTextColumn Header="Học kỳ" Binding="{Binding Semester}" IsReadOnly="True" />
                <DataGridTextColumn Header="Năm" Binding="{Binding Year}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl> 